        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Eres un asistente de inteligencia comercial para Ravell PH, empresa de administración de propiedad horizontal en Bogotá zona norte (Calle 72-100 y alrededores hacia el norte). Recibes el texto crudo de una página con convocatorias o avisos, junto al campo 'fuente'. Debes identificar SOLO convocatorias donde un edificio o conjunto residencial/comercial busca CAMBIAR o CONTRATAR un nuevo administrador de propiedad horizontal (no avisos de otro tipo). Devuelve SOLO un JSON con este formato, sin texto adicional: {\"convocatorias\": [ { \"nombre_edificio\": string, \"zona_o_direccion\": string o null, \"fecha_publicacion\": string en formato YYYY-MM-DD o null, \"link\": string o null, \"fuente\": string } ] }. Si no encuentras ninguna convocatoria relevante, devuelve {\"convocatorias\": []}."
            },
            {
              "role": "user",
              "content": "=Fuente: {{ $json.fuente }}\nURL: {{ $json.url_fuente }}\n\nTexto:\n{{ $json.texto }}"
            }
          ]
        },
        "options": { "responseFormat": "json_object" }
      },
      "id": "12",
      "name": "IA - Detectar convocatorias",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [ 800, 200 ],
      "credentials": { "openAiApi": { "id": "PENDIENTE", "name": "OpenAI Ravell PH" } }
    },
    {
      "parameters": {
        "fieldToSplitOut": "convocatorias",
        "options": {}
      },
      "id": "13",
      "name": "Separar convocatorias",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 1040, 200 ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "value": "PENDIENTE_ID_HOJA_CRM_PROSPECCION" },
        "sheetName": { "value": "60 Edificios Objetivo" },
        "options": {}
      },
      "id": "14",
      "name": "Leer lista de 60 edificios objetivo",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [ 1040, 420 ],
      "credentials": { "googleSheetsOAuth2Api": { "id": "PENDIENTE", "name": "Google Sheets Ravell PH" } }
    },
    {
      "parameters": {
        "jsCode": "const objetivo = $('Leer lista de 60 edificios objetivo').all().map(i => i.json);\n\nconst normalizar = (t) => (t || '').toString().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim();\n\nconst nombreDetectado = normalizar($json.nombre_edificio);\n\nlet match = null;\nfor (const o of objetivo) {\n  const nombreObjetivo = normalizar(o.Edificio);\n  if (nombreObjetivo && nombreDetectado && (nombreDetectado.includes(nombreObjetivo) || nombreObjetivo.includes(nombreDetectado))) {\n    match = o;\n    break;\n  }\n}\n\nreturn {\n  ...$json,\n  coincide_lista_objetivo: match !== null,\n  edificio_objetivo: match ? match.Edificio : null,\n  zona_objetivo: match ? match.Zona : null\n};"
      },
      "id": "15",
      "name": "Cruce con lista objetivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 1280, 200 ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "value": "PENDIENTE_ID_HOJA_CRM_PROSPECCION" },
        "sheetName": { "value": "Convocatorias Detectadas" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Fecha detección": "={{ $now.format('yyyy-MM-dd HH:mm') }}",
            "Edificio detectado": "={{ $json.nombre_edificio }}",
            "Zona/Dirección": "={{ $json.zona_o_direccion }}",
            "Fecha publicación": "={{ $json.fecha_publicacion }}",
            "Fuente": "={{ $json.fuente }}",
            "Link": "={{ $json.link }}",
            "¿Coincide con lista objetivo?": "={{ $json.coincide_lista_objetivo }}",
            "Edificio objetivo": "={{ $json.edificio_objetivo }}",
            "Estado": "Nueva"
          }
        }
      },
      "id": "16",
      "name": "Registrar convocatoria detectada",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
